      "source": "    if (!allHumanChecked) return {label: pendingHumanReview.reason === \"ai_change\" ? tr(\"先核对 AI 建议修改项\", \"Review the AI change suggestion\") : tr(`检查下一项 · 剩余 ${pendingHumanCriteria.length} 项`, `Check next · ${pendingHumanCriteria.length} remaining`), help: tr(`人工检查已确认 ${humanCriteria.length - pendingHumanCriteria.length}/${humanCriteria.length} 项。`, `Human checks confirmed: ${humanCriteria.length - pendingHumanCriteria.length}/${humanCriteria.length}.`), action: openPendingHumanCheck};\n    return {label: collaboration ? tr(\"继续验收确认（不付款）\", \"Continue acceptance — no payment\") : tr(\"继续验收与付款确认\", \"Continue to acceptance & payment\"), help: tr(\"下一步仍需你的明确确认。\", \"Your explicit confirmation is still required.\"), action: () => collaboration ? beginDeliveryAcceptance() : focusPanel(\"payment\")};"
