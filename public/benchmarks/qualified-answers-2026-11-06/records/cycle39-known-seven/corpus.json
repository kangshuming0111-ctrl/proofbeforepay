        "signup.html": "<!DOCTYPE html>\n<html lang=\"en-US\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width\">\n    <title>Good form example</title>\n  </head>\n  <body>\n    <h1>Good form</h1>\n    <form>\n      <div>\n        <label for=\"name\">Enter your name:</label>\n        <input type=\"text\" name=\"name\" id=\"name\">\n      </div>\n      <div>\n        <input type=\"text\" name=\"age\" id=\"age\">\n      </div>\n    </form>\n  </body>\n</html>\n",
